# ローカルの Supabase に接続するための設定。
# このファイルを `.env` という名前でコピーし、値を埋める（`.env` は Git に入らない）。
#
#   npx supabase status -o env
#
# の出力から、次の3つを書き写す:
#   API_URL           → SUPABASE_URL
#   ANON_KEY          → SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY  → SUPABASE_SERVICE_ROLE_KEY
#
# 注意:
#   - ここに書くのは、自分のパソコンの中だけで動くローカル環境の値。
#   - 本物のプロジェクトの鍵（本番・staging）は、絶対にここに書かない。
#   - SERVICE_ROLE_KEY は RLS を迂回できる強い鍵。実際のアプリでは、ブラウザ側のコードに
#     渡さず、サーバー側だけで使う。
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PRACTICE_VALUE=dummy-not-a-secret