{
  "name": "dev-onboarding-lab-m4-app",
  "version": "0.1.0",
  "private": true,
  "description": "M7〜M9 が共有する小さなアプリ（ローカルの Supabase を使う）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "notes": "tsx --env-file=.env src/list-notes.ts",
    "insert": "tsx --env-file=.env src/insert-note.ts",
    "dev": "tsx src/server.ts",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:db": "node --import tsx --test \"test/db/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev:secure": "tsx src/secure-server.ts",
    "dev:secure:unsafe": "tsx src/secure-server.ts --unsafe-demo",
    "seed:users": "tsx src/seed-users.ts",
    "test:secure": "node --import tsx --test \"test/secure/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "supabase": "^2.121.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
